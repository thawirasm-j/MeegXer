{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thawirasm-j/MeegXer/spec/manifest.schema.json",
  "title": "MeegXer node manifest",
  "description": "Declares a node: identity, role, ports, parameters and fit requirements. Spec version 0.2.0 (unstable).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec_version",
    "name",
    "version",
    "type",
    "inputs",
    "outputs"
  ],
  "properties": {
    "spec_version": {
      "description": "Version of this specification the manifest targets.",
      "type": "string",
      "pattern": "^0\\.2\\.[0-9]+$"
    },
    "name": {
      "description": "Globally unique node identifier, lowercase and dotted.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
    },
    "version": {
      "description": "Semantic version of the node implementation.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"
    },
    "type": {
      "description": "stream: block in, block out at the same rate. analysis: windowed input to Features/Events at a lower rate. Sources, probes and sinks use stream.",
      "enum": [
        "stream",
        "analysis"
      ]
    },
    "role": {
      "description": "Node role (CLAUDE.md rule 6).",
      "enum": [
        "source",
        "processor",
        "probe",
        "sink"
      ],
      "default": "processor"
    },
    "availability": {
      "description": "Where the node can run: online (real-time scheduler), offline (batch scheduler; receives the whole recording as one block), or both.",
      "enum": [
        "online",
        "offline",
        "both"
      ],
      "default": "both"
    },
    "description": {
      "type": "string"
    },
    "image": {
      "description": "Container image reference. Present only for external plugins.",
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/port"
      },
      "minItems": 0
    },
    "outputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/port"
      },
      "minItems": 0
    },
    "params": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/param"
      },
      "default": []
    },
    "latency_samples": {
      "description": "Group delay the node adds, in samples.",
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "requires_fit": {
      "description": "True if transform needs a model produced by fit on calibration data.",
      "type": "boolean",
      "default": false
    },
    "requires_positions": {
      "description": "True if the node needs an electrode position for every good channel it processes (e.g. ICLabel). Hosts check the input before running and refuse to start without them (spec 0.2.11).",
      "type": "boolean",
      "default": false
    },
    "live_params": {
      "description": "Parameters that may change while streaming without resetting the node's state. For a node with requires_fit they also leave its fitted model valid (they act in transform only), so changing them never asks for a refit (spec 0.2.6).",
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "default": []
    },
    "channel_types": {
      "description": "Channel types the node processes unless the pipeline says otherwise (spec 0.2.15); the others pass through it. Default: eeg. A node that needs, e.g., the EOG channels declares [\"eeg\", \"eog\"].",
      "type": "array",
      "items": {"enum": ["eeg", "eog", "emg", "ecg", "resp", "stim", "misc"]},
      "minItems": 1,
      "uniqueItems": true
    },
    "category": {
      "description": "Where the node is listed within its group (spec 0.2.15), e.g. filters, reference, artifacts, rate, epochs (preprocessing); spectral, time-frequency, connectivity, complexity, decoding, events (feature extraction); files, streams, actions (outputs). Hosts list a node without one under Other.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "maxLength": 32
    },
    "authors": {
      "description": "Who wrote the node, for credit (spec 0.2.12).",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "references": {
      "description": "What to cite when using the node: the method's papers and the software it builds on (spec 0.2.12). Hosts show them and gather them into session and BIDS provenance.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/reference"
      },
      "default": []
    },
    "license": {
      "description": "Licence of the node's code, ideally an SPDX identifier such as BSD-3-Clause (spec 0.2.12).",
      "type": "string"
    }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "citation"
      ],
      "properties": {
        "citation": {
          "description": "The reference as text, e.g. Author A, Author B (2020). Title. Journal 1(2):3-4.",
          "type": "string",
          "minLength": 1
        },
        "doi": {
          "description": "DOI without the https://doi.org/ prefix.",
          "type": "string",
          "pattern": "^10\\.[0-9]{4,9}/\\S+$"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "type": {
          "enum": [
            "signal",
            "features",
            "events"
          ]
        }
      }
    },
    "param": {
      "type": "object",
      "required": [
        "name",
        "type",
        "default"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "description": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "advanced": {
          "description": "Shown only in the UI's advanced mode; friendly mode uses the default.",
          "type": "boolean",
          "default": false
        },
        "primary": {
          "description": "A crucial parameter: shown on the node's strip in the UI's friendly mode.",
          "type": "boolean",
          "default": false
        }
      },
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "float"
            },
            "default": {
              "type": "number"
            },
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "step": {
              "description": "How much one step (arrow, wheel) changes the value in a UI (spec 0.2.13); hosts choose one when absent.",
              "type": "number",
              "exclusiveMinimum": 0
            },
            "name": true,
            "description": true,
            "unit": true,
            "advanced": true,
            "primary": true
          },
          "additionalProperties": false
        },
        {
          "properties": {
            "type": {
              "const": "int"
            },
            "default": {
              "type": "integer"
            },
            "min": {
              "type": "integer"
            },
            "max": {
              "type": "integer"
            },
            "step": {
              "description": "How much one step (arrow, wheel) changes the value in a UI (spec 0.2.13); hosts choose one when absent.",
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "name": true,
            "description": true,
            "unit": true,
            "advanced": true,
            "primary": true
          },
          "additionalProperties": false
        },
        {
          "properties": {
            "type": {
              "const": "bool"
            },
            "default": {
              "type": "boolean"
            },
            "name": true,
            "description": true,
            "advanced": true,
            "primary": true
          },
          "additionalProperties": false
        },
        {
          "properties": {
            "type": {
              "const": "enum"
            },
            "default": {
              "type": "string"
            },
            "choices": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "name": true,
            "description": true,
            "advanced": true,
            "primary": true
          },
          "required": [
            "choices"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": {
              "const": "string"
            },
            "default": {
              "type": "string"
            },
            "name": true,
            "description": true,
            "advanced": true,
            "primary": true
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
