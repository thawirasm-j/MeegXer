{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thawirasm-j/MeegXer/spec/pipeline.schema.json",
  "title": "MeegXer pipeline",
  "description": "A processing graph as an ordered node list. Each node's input must name an earlier node, so the graph is acyclic by construction. When input is omitted it defaults to the nearest earlier source or processor whose output port type matches the node's input (since 0.2.7), so a plain list is a linear chain from which Features nodes branch off. Spec version 0.2.7 (unstable).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec_version",
    "nodes"
  ],
  "properties": {
    "spec_version": {
      "type": "string",
      "pattern": "^0\\.2\\.[0-9]+$"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node"
        ],
        "properties": {
          "id": {
            "description": "Unique within the pipeline; defaults to the node's last name segment plus a counter.",
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "node": {
            "description": "Manifest name of an installed node.",
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
          },
          "params": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "number",
                "string",
                "boolean"
              ]
            },
            "default": {}
          },
          "input": {
            "description": "id of the node feeding this one.",
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "strip_params": {
            "description": "UI: parameters shown on the node's strip in advanced mode (up to 3). Display only; does not affect processing.",
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 3,
            "uniqueItems": true
          },
          "pass_uncalibrated": {
            "description": "For processors that need calibration: pass data through unprocessed (marked as bypassed) while the node has no valid model. Default false: block until calibrated.",
            "type": "boolean",
            "default": false
          },
          "channel_types": {
            "description": "Processors only: the channel types this node processes; channels of other types pass through it untouched. Channels without a type count as EEG. Default: [\"eeg\"] (EOG, ECG, EMG and others are left alone unless listed).",
            "type": "array",
            "items": {
              "enum": [
                "eeg",
                "eog",
                "emg",
                "ecg",
                "resp",
                "stim",
                "misc"
              ]
            },
            "minItems": 1,
            "uniqueItems": true,
            "default": [
              "eeg"
            ]
          },
          "recording": {
            "description": "Sources only: how the recording is described (spec 0.2.3). Changes labels, types, bad flags, positions and events; never the samples.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "channels": {
                "description": "Per channel, keyed by the label the source reports.",
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "rename": {
                      "type": "string",
                      "minLength": 1
                    },
                    "type": {
                      "enum": [
                        "eeg",
                        "eog",
                        "emg",
                        "ecg",
                        "resp",
                        "stim",
                        "misc"
                      ]
                    },
                    "bad": {
                      "type": "boolean"
                    },
                    "position": {
                      "description": "x, y, z in metres (x right, y front, z up)",
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 3,
                      "maxItems": 3
                    }
                  }
                }
              },
              "montage": {
                "description": "A standard montage name (e.g. standard_1005) or a montage file path (.elc, .sfp, .loc, .bvef, BIDS electrodes.tsv, ...).",
                "type": "string"
              },
              "events": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "file": {
                    "description": "Events file (BIDS events.tsv, or CSV/TSV with onset, duration, label); replaces the recording's own events.",
                    "type": "string"
                  },
                  "rename": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "drop": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "uniqueItems": true
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {}
}
